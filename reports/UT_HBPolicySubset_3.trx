          <Message>CREATE STREAM foo_1s_final_s WITH (KAFKA_TOPIC='foo_1s_final_s', KEY_FORMAT='AVRO', VALUE_FORMAT='AVRO') AS
SELECT *
FROM foo o
EMIT CHANGES;
CREATE TABLE foo_1s_final WITH (KAFKA_TOPIC='foo_1s_final', KEY_FORMAT='AVRO', VALUE_FORMAT='AVRO') AS
SELECT *
FROM foo_1s_final_s o WINDOW TUMBLING (SIZE 1 MINUTES)
EMIT FINAL;
CREATE TABLE foo_hb_1s WITH (KAFKA_TOPIC='foo_hb_1s', KEY_FORMAT='AVRO', VALUE_FORMAT='AVRO') AS
SELECT *
FROM foo_1s_final_s o WINDOW TUMBLING (SIZE 1 MINUTES)
EMIT CHANGES;
CREATE TABLE foo_1m_live WITH (KAFKA_TOPIC='foo_1m_live', KEY_FORMAT='AVRO', VALUE_FORMAT='AVRO') AS
SELECT *
FROM foo_1s_final_s o WINDOW TUMBLING (SIZE 1 MINUTES)
EMIT CHANGES;
CREATE TABLE foo_hb_1m WITH (KAFKA_TOPIC='foo_hb_1m', KEY_FORMAT='AVRO', VALUE_FORMAT='AVRO') AS
SELECT *
FROM foo_1s_final_s o WINDOW TUMBLING (SIZE 1 MINUTES)
EMIT CHANGES;
CREATE TABLE foo_1m_fill WITH (KAFKA_TOPIC='foo_1m_fill', KEY_FORMAT='AVRO', VALUE_FORMAT='AVRO') AS
SELECT h.KEY-&gt;ID AS Id, h.KEY-&gt;BUCKETSTART AS BucketStart, h.BucketStart AS BucketStart, COALESCE(l.KsqlTimeFrameClose, p.KsqlTimeFrameClose) AS KsqlTimeFrameClose
FROM foo_hb_1m h LEFT JOIN foo_1m_live l ON h.KEY-&gt;ID = l.KEY-&gt;ID AND h.KEY-&gt;BUCKETSTART = l.KEY-&gt;BUCKETSTART AND h.BucketStart = l.BucketStart
LEFT JOIN foo_prev_1m p ON h.KEY-&gt;ID = p.KEY-&gt;ID AND h.KEY-&gt;BUCKETSTART = p.KEY-&gt;BUCKETSTART AND h.BucketStart = p.BucketStart
EMIT CHANGES;
CREATE TABLE foo_prev_1m WITH (KAFKA_TOPIC='foo_prev_1m', KEY_FORMAT='AVRO', VALUE_FORMAT='AVRO') AS
SELECT h.KEY-&gt;ID AS Id, h.KEY-&gt;BUCKETSTART AS BucketStart, h.BucketStart AS BucketStart, l.KsqlTimeFrameClose AS KsqlTimeFrameClose
FROM foo_hb_1m h LEFT JOIN foo_1m_live l ON h.KEY-&gt;ID = l.KEY-&gt;ID AND h.KEY-&gt;BUCKETSTART = l.KEY-&gt;BUCKETSTART AND l.BucketStart = TIMESTAMPADD(MINUTES, -1, h.BucketStart)
EMIT CHANGES;
CREATE TABLE foo_5m_live WITH (KAFKA_TOPIC='foo_5m_live', KEY_FORMAT='AVRO', VALUE_FORMAT='AVRO') AS
SELECT *
FROM foo_1s_final_s o WINDOW TUMBLING (SIZE 5 MINUTES)
EMIT CHANGES;
CREATE TABLE foo_hb_5m WITH (KAFKA_TOPIC='foo_hb_5m', KEY_FORMAT='AVRO', VALUE_FORMAT='AVRO') AS
SELECT *
FROM foo_1s_final_s o WINDOW TUMBLING (SIZE 5 MINUTES)
EMIT CHANGES;
CREATE TABLE foo_5m_fill WITH (KAFKA_TOPIC='foo_5m_fill', KEY_FORMAT='AVRO', VALUE_FORMAT='AVRO') AS
SELECT h.KEY-&gt;ID AS Id, h.KEY-&gt;BUCKETSTART AS BucketStart, h.BucketStart AS BucketStart, l.KsqlTimeFrameClose AS KsqlTimeFrameClose
FROM foo_hb_5m h LEFT JOIN foo_5m_live l ON h.KEY-&gt;ID = l.KEY-&gt;ID AND h.KEY-&gt;BUCKETSTART = l.KEY-&gt;BUCKETSTART AND h.BucketStart = l.BucketStart
EMIT CHANGES;
Expected: True
Actual:   False</Message>
